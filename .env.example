# ===== DeepSeek LLM =====
# 在 https://platform.deepseek.com 创建 API Key 后填入
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ===== Embedding =====
# local: 本机 BGE-M3（CPU 保底）；api: 调用硅基流动等 OpenAI 兼容接口
EMBEDDING_MODE=local
# 仅 EMBEDDING_MODE=api 时需要：
# EMBEDDING_API_KEY=
# EMBEDDING_API_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_MODEL=BAAI/bge-m3

# ===== 服务 =====
API_HOST=0.0.0.0
API_PORT=8000

# ===== 数据目录（默认相对项目根）=====
DATA_DIR=data
VECTOR_DIR=data/vector
