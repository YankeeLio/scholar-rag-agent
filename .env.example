# ===== DeepSeek LLM =====
# 在 https://platform.deepseek.com 创建 API Key 后填入 apps/api/.env
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_CHAT_MODEL=deepseek-chat
LLM_REASON_MODEL=deepseek-reasoner

# ===== Embedding =====
# 本地 BGE-M3（CPU 保底，模型缓存在 data/hf_cache，首次运行自动下载）
BGE_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# ===== 检索 =====
CHUNK_MAX_CHARS=1800
RETRIEVAL_TOP_K=5

# ===== 服务 =====
API_HOST=0.0.0.0
API_PORT=8000

# ===== 数据目录（默认相对项目根）=====
DATA_DIR=data
VECTOR_DIR=data/chroma
HF_HOME=data/hf_cache
PDF_DIR=pdf
